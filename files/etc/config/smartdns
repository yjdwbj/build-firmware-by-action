
config smartdns
	option enabled '1'
	option server_name 'smartdns'
	option port '6053'
	option auto_set_dnsmasq '1'
	option tcp_server '1'
	option ipv6_server '1'
	option bind_device '1'
	option dualstack_ip_selection '1'
	option force_aaaa_soa '0'
	option force_https_soa '0'
	option prefetch_domain '1'
	option serve_expired '1'
	option cache_size '32768'
	option cache_persist '1'
	option rr_ttl_min '300'
	option rr_ttl_reply_max '60'
	option resolve_local_hostnames '0'
	option speed_check_mode 'ping,tcp:443,tcp:80'
	list conf_files '/tmp/smartdns/adb_list.overall'
	option old_port '6053'
	option old_enabled '1'
	option old_auto_set_dnsmasq '1'

config domain-rule

